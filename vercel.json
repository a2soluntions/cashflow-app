{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-optional",
  "crons": [
    {
      "path": "/api/cron-notify-bills",
      "schedule": "0 11 * * *"
    }
  ]
}


